# Copy this file to .env and fill in what you need. The server reads .env at startup.
# Every line is optional: the app runs with none of them set.

# Port the API (and, in production, the whole site) listens on.
PORT=3001

# Folder for the database and temporary uploads. Defaults to server/data.
# DATA_DIR=/var/lib/swipeproof
# Or set just the database file:
# DATABASE_PATH=/var/lib/swipeproof/swipeproof.db

# ---- Full video analysis ----
# Needs ffmpeg and ffprobe installed. Set these only if they are not on your PATH.
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# Speech to text. Without a key, full analyses skip what is said.
# OPENAI_API_KEY=
# TRANSCRIBE_MODEL=gpt-transcribe

# Written feedback. Without a key, reports have scores and fixes but no coach notes.
# ANTHROPIC_API_KEY=
# FEEDBACK_MODEL=claude-haiku-5-5

# Set to "demo" to try the full flow with canned transcript and feedback and no keys.
# AI_PROVIDER=demo

# Limits that keep costs bounded.
# MAX_UPLOAD_MB=200
# MAX_VIDEO_SECONDS=300
# DAILY_ANALYSIS_LIMIT=20

# ---- Production ----
# Marks the login cookie Secure. Set when the site is served over HTTPS.
# NODE_ENV=production
# Number of reverse proxies in front of the server, so rate limits see the visitor's address.
# TRUST_PROXY=1
